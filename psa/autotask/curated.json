     "example": "148372"
    },
    {
     "key": "ticket.title",
     "name": { "en": "Ticket: Title", "de": "Ticket: Titel", "es": "Ticket: Título" },
     "description": "Ticket-Titel",
     "example": "Drucker im 2. OG druckt nicht"
    },
    {
     "key": "ticket.description",
     "name": { "en": "Ticket: Description", "de": "Ticket: Beschreibung", "es": "Ticket: Descripción" },
