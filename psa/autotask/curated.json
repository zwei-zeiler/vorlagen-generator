 "note": "Namen je Sprache exakt wie in den offiziellen Autotask-Tabellen — pruefbar mit tools/build-psa-catalog.py --check. Beschreibung und Beispiel sind bewusst immer deutsch: die App-UI und die erzeugten Mails sind deutsch, nur die Variablennamen folgen der Zone.",
 "categories": [
  {
   "key": "ticket",
   "name": "Ticket",
   "variables": [
    {
     "key": "ticket.number",
     "name": { "en": "Ticket: Number", "de": "Ticket: Nummer", "es": "Ticket: Número" },
     "description": "Ticket-Nummer",
     "example": "T20250401.0042"
    },
    {
     "key": "ticket.numberWithLink",
     "name": { "en": "Ticket: Number (with link)", "de": "Ticket: Nummer (mit Link)", "es": "Ticket: Número (con vínculo)" },
     "description": "Ticket-Nummer als Link",
     "example": "<a href='#'>T20250401.0042</a>"
    },
    {
     "key": "ticket.id",
     "name": { "en": "Ticket: ID", "de": "Ticket: ID", "es": "Ticket: Id." },
